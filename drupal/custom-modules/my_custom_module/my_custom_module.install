<?php

/**
 * Implements hook_schema().
 */
function my_custom_module_schema() {
  $schema['my_custom_module_products_import_status'] = [
    'description' => 'Stores grocery import status for each store/import run.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
      'store_id' => [
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'never',
      ],
      'started' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'finished' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'products_imported' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'failure_reason' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'url' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'store_id' => ['store_id'],
      'status' => ['status'],
      'started' => ['started'],
    ],
  ];

  return $schema;
}

/**
 * Creates the import status table for existing installations.
 */
function my_custom_module_update_11001() {
  $table = 'my_custom_module_products_import_status';
  $schema = \Drupal::database()->schema();

  if (!$schema->tableExists($table)) {
    $definitions = my_custom_module_schema();
    $schema->createTable($table, $definitions[$table]);
  }
}
