<div class="container py-4">
  <h1 class="mb-4">{{ 'Choose how you want to continue ?'|t }}</h1>
    <div class="row g-4">
      {% for link in links %}
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm h-100">
            <div class="card-body text-center">
              <a class="btn btn-primary btn-lg w-100" href="{{ link.url.toString() }}">{{ link.title }}</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
</div>
